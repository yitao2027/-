[Unit]
Description=ShaoziClaw Update Server
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/shaoziclaw-updater/api
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
Environment=PORT=3000
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
